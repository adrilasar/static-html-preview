{
  "name": "static-html-preview",
  "displayName": "Static HTML Preview",
  "description": "Edit HTML on the left with a live, offline preview on the right. Works locally and over SSH.",
  "version": "0.2.0",
  "icon": "assets/icon.png",
  "publisher": "adrilasar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrilasar/static-html-preview.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": ["html", "preview", "offline", "ssh", "vscodium"],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "adrilasar.staticHtmlPreview",
        "displayName": "Static HTML Preview",
        "selector": [
          {
            "filenamePattern": "*.[hH][tT][mM][lL]"
          },
          {
            "filenamePattern": "*.[hH][tT][mM]"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && node scripts/build.mjs",
    "test": "npm run build && node --test --experimental-test-isolation=none test/preview.test.cjs",
    "test:editor": "npm test && node scripts/test-editor.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "css-tree": "3.2.1",
    "esbuild": "0.28.2",
    "parse5": "7.3.0",
    "typescript": "7.0.2",
    "vscode-uri": "3.2.0"
  }
}
